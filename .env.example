# Copy to .env and fill in. Never commit .env.

# --- Hugging Face (local model downloads only) ---
HF_TOKEN=
# Model cache location (gitignored, lives under data/)
HF_HOME=./data/cache/hf

# --- Script-writing LLM (hosted Claude) ---
ANTHROPIC_API_KEY=
# Chosen in the Day 0 bake-off: claude-haiku-5-5 (cheap) or claude-sonnet-5-5 (better)
LLM_MODEL=claude-haiku-5-5

# --- Data sources ---
# football-data.org free token (scores)
FOOTBALL_DATA_TOKEN=
# Twelve Data or Alpha Vantage key (markets). CoinGecko needs no key.
MARKET_API_KEY=
# TomTom traffic-flow key (optional; skip traffic segments if unset)
TOMTOM_API_KEY=
# No key needed: Open-Meteo, Aladhan, OpenSky, RSS feeds
